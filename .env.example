# Copy to .env and fill in to use the Supabase backend.
# Without these values the app runs in local mode (data only on this device).
# The anon key is public by design – all data is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put AI provider keys (OpenAI/Anthropic/…) here – EXPO_PUBLIC_* values are bundled into the app.
# They belong in Supabase Edge Function secrets (Phase 4).
